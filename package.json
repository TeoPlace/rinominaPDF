{
  "name": "rinominapdf",
  "productName": "rinominaPDF",
  "version": "2.0.1",
  "private": true,
  "description": "Rinomina i PDF di una cartella leggendone il barcode",
  "author": "teo.place",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "build:main": "node scripts/build-main.js",
    "build:ui": "vite build",
    "build": "npm run build:main && npm run build:ui",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --config electron-builder-config.js"
  },
  "dependencies": {
    "@teoplace/kit": "file:../teo-kit",
    "@tabler/icons-react": "^3.34.0",
    "koffi": "^2.9.0",
    "pdfjs-dist": "^5.0.0",
    "@napi-rs/canvas": "^0.1.70"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.8.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "electron@43.8.4": true,
    "esbuild": true
  }
